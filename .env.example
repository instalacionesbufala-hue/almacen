# Copia este archivo como .env.local para desarrollo. Nunca subas .env.local al repositorio.
# En GitHub van en Settings → Secrets and variables → Actions → pestaña "Variables" (no son secretas).

# --- Nube (Supabase). Si se dejan vacías, la app funciona en modo demostración en el navegador. ---
# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=
# Supabase → Project Settings → API → clave "anon public". Es pública por diseño: la seguridad está en RLS.
VITE_SUPABASE_ANON_KEY=

# --- Lectura de albaranes con IA (E-003, Gemini). Vacía = modo simulado. ---
# URL de la función: https://<proyecto>.supabase.co/functions/v1/leer-albaran
VITE_ALBARANES_URL=

# --- Notificaciones push en el móvil (E-006). Clave VAPID PÚBLICA; la privada va solo en los secretos de Supabase. ---
VITE_VAPID_PUBLICA=

# --- Solo para la copia de seguridad (GitHub → Secrets, NUNCA aquí ni en la app) ---
# SUPABASE_DB_URL   cadena "Session pooler" de Supabase → Connect (incluye la contraseña de la base de datos)
# COPIA_CLAVE       contraseña larga con la que se cifran las copias (guárdala también fuera de GitHub)
# COPIAS_TOKEN      token de GitHub con permiso de escritura SOLO en el repositorio privado de copias
# y la variable COPIAS_REPO = usuario/almacen-copias
